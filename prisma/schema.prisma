/// -----------------------------------------------------------------------------
/// File: prisma/schema.prisma
/// Project: Priciq Backend
/// Layer: Database Schema
///
/// Purpose:
/// Defines the Prisma client generator, datasource, enums, and core business
/// models for the Priciq application.
/// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// -----------------------------------------------------------------------------
/// Enums
/// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum AlertStatus {
  ACTIVE
  PAUSED
  TRIGGERED
}

/// -----------------------------------------------------------------------------
/// User
/// -----------------------------------------------------------------------------

model User {
  id        String @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String @unique
  password  String

  role UserRole @default(USER)

  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  searchHistory   SearchHistory[]
  comparisons     Comparison[]
  savedProducts   SavedProduct[]
  priceAlerts     PriceAlert[]
  recommendations Recommendation[]

  @@index([email])
  @@map("users")
}

/// -----------------------------------------------------------------------------
/// Category
/// -----------------------------------------------------------------------------

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?

  parentId String? @db.Uuid

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@map("categories")
}

/// -----------------------------------------------------------------------------
/// Brand
/// -----------------------------------------------------------------------------

model Brand {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@map("brands")
}

/// -----------------------------------------------------------------------------
/// Product
/// -----------------------------------------------------------------------------

model Product {
  id String @id @default(uuid()) @db.Uuid

  name        String
  slug        String  @unique
  sku         String? @unique
  modelNumber String?

  description  String?
  thumbnailUrl String?

  isActive Boolean @default(true)

  categoryId String @db.Uuid
  brandId    String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  images ProductImage[]
  offers Offer[]

  comparisonItems ComparisonItem[]
  savedByUsers    SavedProduct[]
  priceAlerts     PriceAlert[]
  recommendations Recommendation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([categoryId, brandId])
  @@map("products")
}

/// -----------------------------------------------------------------------------
/// Product Image
/// -----------------------------------------------------------------------------

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid

  url     String
  altText String?

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sortOrder])
  @@index([productId])
  @@map("product_images")
}

/// -----------------------------------------------------------------------------
/// Store
/// -----------------------------------------------------------------------------

model Store {
  id String @id @default(uuid()) @db.Uuid

  name String @unique
  slug String @unique

  websiteUrl String
  logoUrl    String?

  country  String?
  currency String  @default("NGN")

  status StoreStatus @default(ACTIVE)

  offers Offer[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@map("stores")
}

/// -----------------------------------------------------------------------------
/// Offer
/// -----------------------------------------------------------------------------

model Offer {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid
  storeId   String @db.Uuid

  title      String
  productUrl String

  currentPrice  Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @db.Decimal(12, 2)

  currency String @default("NGN")

  discountPercentage Float?

  inStock      Boolean @default(true)
  availability String?

  rating      Float?
  reviewCount Int?

  scrapedAt     DateTime  @default(now())
  lastScrapedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  priceHistory PriceHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
  @@index([currentPrice])
  @@index([inStock])
  @@map("offers")
}

/// -----------------------------------------------------------------------------
/// Price History
/// -----------------------------------------------------------------------------

model PriceHistory {
  id String @id @default(uuid()) @db.Uuid

  offerId String @db.Uuid

  price Decimal @db.Decimal(12, 2)

  recordedAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, recordedAt])
  @@map("price_history")
}

/// -----------------------------------------------------------------------------
/// Search History
/// -----------------------------------------------------------------------------

model SearchHistory {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  query  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("search_history")
}

/// -----------------------------------------------------------------------------
/// Comparison
/// -----------------------------------------------------------------------------

model Comparison {
  id String @id @default(uuid()) @db.Uuid

  userId String  @db.Uuid
  name   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ComparisonItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("comparisons")
}

/// -----------------------------------------------------------------------------
/// Comparison Item
/// -----------------------------------------------------------------------------

model ComparisonItem {
  id String @id @default(uuid()) @db.Uuid

  comparisonId String @db.Uuid
  productId    String @db.Uuid

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, productId])
  @@map("comparison_items")
}

/// -----------------------------------------------------------------------------
/// Saved Product
/// -----------------------------------------------------------------------------

model SavedProduct {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  productId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("saved_products")
}

/// -----------------------------------------------------------------------------
/// Price Alert
/// -----------------------------------------------------------------------------

model PriceAlert {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  productId String @db.Uuid

  targetPrice Decimal @db.Decimal(12, 2)

  status AlertStatus @default(ACTIVE)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("price_alerts")
}

/// -----------------------------------------------------------------------------
/// Recommendation
/// -----------------------------------------------------------------------------

model Recommendation {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  productId String @db.Uuid

  score Float

  reason String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("recommendations")
}
