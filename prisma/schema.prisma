/// -----------------------------------------------------------------------------
/// File: prisma/schema.prisma
/// Project: Priciq Backend
/// Layer: Database Schema
///
/// Purpose:
/// Defines the Prisma client generator, datasource, and shared enums.
/// Database connection is configured in `prisma.config.ts` (Prisma 7).
/// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// -----------------------------------------------------------------------------
/// Shared Enums
/// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum AlertStatus {
  ACTIVE
  PAUSED
  TRIGGERED
}