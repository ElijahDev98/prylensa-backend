NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prylensa
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
LOG_LEVEL=info
AI_SERVICE_URL=http://localhost:8001/api/v1
INTERNAL_AI_API_KEY=replace-with-a-long-random-internal-key
MARKETPLACE_CACHE_TTL_MS=120000
MONITORING_INTERVAL_MS=900000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180
