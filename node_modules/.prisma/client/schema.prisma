/// -----------------------------------------------------------------------------
/// File: prisma/schema.prisma
/// Project: Prylensa Backend
/// Layer: Database Schema
///
/// Purpose:
/// Defines the Prisma client generator, datasource, enums, and core business
/// models for the Prylensa application.
/// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// -----------------------------------------------------------------------------
/// Enums
/// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum AlertStatus {
  ACTIVE
  PAUSED
  TRIGGERED
}

/// -----------------------------------------------------------------------------
/// User
/// -----------------------------------------------------------------------------

model User {
  id        String @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String @unique
  password  String

  role UserRole @default(USER)

  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  searchHistory               SearchHistory[]
  savedSearches               SavedSearch[]
  comparisons                 Comparison[]
  savedProducts               SavedProduct[]
  priceAlerts                 PriceAlert[]
  alertEvents                 AlertEvent[]
  recommendations             Recommendation[]
  preference                  UserPreference?
  sessions                    AuthSession[]
  comparisonWorkspace         ComparisonWorkspace?
  personalizedRecommendations PersonalizedRecommendation[]

  @@index([email])
  @@map("users")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

/// -----------------------------------------------------------------------------
/// Category
/// -----------------------------------------------------------------------------

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?

  parentId String? @db.Uuid

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@map("categories")
}

/// -----------------------------------------------------------------------------
/// Brand
/// -----------------------------------------------------------------------------

model Brand {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@map("brands")
}

/// -----------------------------------------------------------------------------
/// Product
/// -----------------------------------------------------------------------------

model Product {
  id String @id @default(uuid()) @db.Uuid

  name        String
  slug        String  @unique
  sku         String? @unique
  modelNumber String?

  description  String?
  thumbnailUrl String?

  isActive Boolean @default(true)

  categoryId String @db.Uuid
  brandId    String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  images ProductImage[]
  offers Offer[]

  comparisonItems     ComparisonItem[]
  savedByUsers        SavedProduct[]
  priceAlerts         PriceAlert[]
  recommendations     Recommendation[]
  marketplaceListings MarketplaceListing[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([categoryId, brandId])
  @@map("products")
}

/// -----------------------------------------------------------------------------
/// Product Image
/// -----------------------------------------------------------------------------

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid

  url     String
  altText String?

  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sortOrder])
  @@index([productId])
  @@map("product_images")
}

/// -----------------------------------------------------------------------------
/// Store
/// -----------------------------------------------------------------------------

model Store {
  id String @id @default(uuid()) @db.Uuid

  name String @unique
  slug String @unique

  websiteUrl String
  logoUrl    String?

  country  String?
  currency String  @default("NGN")

  status StoreStatus @default(ACTIVE)

  offers Offer[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@map("stores")
}

/// -----------------------------------------------------------------------------
/// Offer
/// -----------------------------------------------------------------------------

model Offer {
  id String @id @default(uuid()) @db.Uuid

  productId String @db.Uuid
  storeId   String @db.Uuid

  title      String
  productUrl String

  currentPrice  Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @db.Decimal(12, 2)

  currency String @default("NGN")

  discountPercentage Float?

  inStock      Boolean @default(true)
  availability String?

  rating      Float?
  reviewCount Int?

  scrapedAt     DateTime  @default(now())
  lastScrapedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  priceHistory PriceHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
  @@index([currentPrice])
  @@index([inStock])
  @@map("offers")
}

/// -----------------------------------------------------------------------------
/// Price History
/// -----------------------------------------------------------------------------

model PriceHistory {
  id String @id @default(uuid()) @db.Uuid

  offerId String @db.Uuid

  price Decimal @db.Decimal(12, 2)

  recordedAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, recordedAt])
  @@map("price_history")
}

/// -----------------------------------------------------------------------------
/// Search History
/// -----------------------------------------------------------------------------

model SearchHistory {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  query  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("search_history")
}

model SavedSearch {
  id String @id @default(uuid()) @db.Uuid

  userId          String @db.Uuid
  query           String
  normalizedQuery String

  lastRefreshedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedQuery])
  @@index([userId, updatedAt])
  @@map("saved_searches")
}

/// -----------------------------------------------------------------------------
/// Comparison
/// -----------------------------------------------------------------------------

model Comparison {
  id String @id @default(uuid()) @db.Uuid

  userId String  @db.Uuid
  name   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ComparisonItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("comparisons")
}

/// -----------------------------------------------------------------------------
/// Comparison Item
/// -----------------------------------------------------------------------------

model ComparisonItem {
  id String @id @default(uuid()) @db.Uuid

  comparisonId String @db.Uuid
  productId    String @db.Uuid

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, productId])
  @@map("comparison_items")
}

model ComparisonWorkspace {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  items  Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comparison_workspaces")
}

/// -----------------------------------------------------------------------------
/// Saved Product
/// -----------------------------------------------------------------------------

model SavedProduct {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  productId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("saved_products")
}

/// -----------------------------------------------------------------------------
/// Price Alert
/// -----------------------------------------------------------------------------

model PriceAlert {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @db.Uuid
  productId String? @db.Uuid

  name         String  @default("Price alert")
  productQuery String  @default("")
  ruleType     String  @default("price-drop")
  threshold    Float   @default(0)
  description  String  @default("")
  enabled      Boolean @default(true)

  targetPrice Decimal? @db.Decimal(12, 2)

  status AlertStatus @default(ACTIVE)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  events  AlertEvent[]

  lastEvaluatedAt DateTime?
  lastTriggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId, enabled, status])
  @@index([productQuery])
  @@map("price_alerts")
}

model AlertEvent {
  id String @id @default(uuid()) @db.Uuid

  alertId String @db.Uuid
  userId  String @db.Uuid

  fingerprint  String
  title        String
  message      String
  productQuery String
  eventType    String
  metadata     Json?

  readAt      DateTime?
  triggeredAt DateTime  @default(now())

  alert PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, fingerprint])
  @@index([userId, readAt, triggeredAt])
  @@map("alert_events")
}

model UserPreference {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid

  currency             String  @default("NGN")
  notificationsEnabled Boolean @default(true)
  theme                String  @default("light")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

/// -----------------------------------------------------------------------------
/// Recommendation
/// -----------------------------------------------------------------------------

model Recommendation {
  id String @id @default(uuid()) @db.Uuid

  userId    String @db.Uuid
  productId String @db.Uuid

  score Float

  reason String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("recommendations")
}

model PersonalizedRecommendation {
  id String @id @default(uuid()) @db.Uuid

  userId      String  @db.Uuid
  productKey  String
  query       String
  title       String
  description String
  priority    String
  metadata    Json?
  feedback    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, productKey])
  @@index([userId, updatedAt])
  @@map("personalized_recommendations")
}

/// -----------------------------------------------------------------------------
/// Marketplace learning dataset
/// -----------------------------------------------------------------------------

model MarketplaceSearch {
  id String @id @default(uuid()) @db.Uuid

  query           String
  normalizedQuery String

  resultCount      Int @default(0)
  offerCount       Int @default(0)
  marketplaceCount Int @default(0)

  aiGeneratedAt DateTime?
  createdAt     DateTime  @default(now())

  observations SearchObservation[]

  @@index([normalizedQuery, createdAt])
  @@index([createdAt])
  @@map("marketplace_searches")
}

model MarketplaceListing {
  id String @id @default(uuid()) @db.Uuid

  marketplace       String
  externalOfferId   String
  externalProductId String?
  canonicalKey      String
  productId         String? @db.Uuid

  title           String
  normalizedTitle String
  brand           String?
  category        String?
  modelNumber     String?
  gtin            String?

  productUrl String?
  imageUrl   String?

  enrichmentSource String?
  specifications   Json?
  enrichedAt       DateTime?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  snapshots OfferSnapshot[]
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([marketplace, externalOfferId])
  @@index([canonicalKey])
  @@index([productId])
  @@index([normalizedTitle])
  @@index([gtin])
  @@map("marketplace_listings")
}

model OfferSnapshot {
  id String @id @default(uuid()) @db.Uuid

  listingId String @db.Uuid
  stateHash String

  price         Decimal  @db.Decimal(14, 2)
  originalPrice Decimal? @db.Decimal(14, 2)
  currency      String   @default("NGN")

  rating      Float?
  reviewCount Int?
  inStock     Boolean @default(true)

  firstObservedAt  DateTime @default(now())
  lastObservedAt   DateTime @default(now())
  observationCount Int      @default(1)

  listing      MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  observations SearchObservation[]

  @@unique([listingId, stateHash])
  @@index([listingId, firstObservedAt])
  @@index([currency, price])
  @@map("offer_snapshots")
}

model SearchObservation {
  id String @id @default(uuid()) @db.Uuid

  searchId   String @db.Uuid
  snapshotId String @db.Uuid

  comparisonKey String
  groupPosition Int

  relevanceScore  Float?
  confidenceScore Float?
  evaluationScore Float?
  isBestOffer     Boolean @default(false)

  createdAt DateTime @default(now())

  search   MarketplaceSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  snapshot OfferSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([searchId, snapshotId])
  @@index([comparisonKey, createdAt])
  @@index([snapshotId])
  @@map("search_observations")
}
